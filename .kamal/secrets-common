# Shared Kamal secrets, resolved from the gitignored .env (loaded at the
# top of config/deploy.yml). These are the app-side HTTP credentials:
#
#   INGRESS_PASSWORD       = the app's action_mailbox.ingress_password
#   INTERNAL_API_PASSWORD  = the app's mail_on_rails.internal_api_password
#
# Both must match the values the mail_on_rails app is configured with.
INGRESS_PASSWORD=$INGRESS_PASSWORD
INTERNAL_API_PASSWORD=$INTERNAL_API_PASSWORD
