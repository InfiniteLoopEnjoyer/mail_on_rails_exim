# Copy to .env (gitignored) and fill in. Loaded by config/deploy.yml and
# resolved for Kamal secrets via .kamal/secrets-common.

# Must match the app's action_mailbox.ingress_password.
INGRESS_PASSWORD=change-me

# Must match the app's mail_on_rails.internal_api_password
# (also settable app-side as SMTP_INTERNAL_API_PASSWORD). Used for SMTP
# AUTH checks and outbound queueing.
INTERNAL_API_PASSWORD=change-me
