######################################################################
# mail_on_rails_exim - Exim mail edge for the mail_on_rails app.
#
# Rendered to /etc/exim4/exim4.conf at container start by bin/entrypoint,
# which substitutes the @@EXIM_*@@ placeholders (Exim's own $variables and
# ${expansions} are left untouched). The Ruby helper scripts (bin/*) do
# the HTTP work; Exim invokes them as `/usr/local/bin/ruby <script>`.
#
# Flow:
#   - Inbound (:25) and authenticated submission to a local domain -> the
#     app's Action Mailbox relay ingress (bin/rails-ingress). Rails matches
#     recipients to accounts and scans for viruses/spam. Unauthenticated
#     inbound recipients are first verified at RCPT time against the
#     local_recipients file the app maintains on the shared mailconf
#     volume (no HTTP call): a domain we host with no such account gets
#     550, so unknown users bounce at the sender instead of being silently
#     dropped.
#     When EXIM_CLAMAV_ADDR is set, every completed message is also
#     virus-scanned at DATA time (acl_data: infected -> 550, scanner
#     down -> 451) before it is accepted and POSTed anywhere.
#   - Authenticated submission to a REMOTE domain -> queued in the app via
#     the internal API (bin/rails-outbound); the app DKIM-signs and sends.
#     This is the only path that leaves for another server and it requires
#     a valid login, so accepting all recipients is NOT an open relay.
#   - AUTH credentials are checked against the app's internal API
#     (bin/auth-check), offered only over TLS and never on port 25.
#
# Trust / secrets: this file holds no secrets - the Ruby helpers read
# INGRESS_PASSWORD / INTERNAL_API_PASSWORD from the environment (passed to
# child processes via keep_environment). The app's mailroom TRUSTS
# X-Original-To / Return-Path / X-MailOnRails-* headers, so bin/rails-ingress
# strips any forged copies before stamping the authoritative ones. The
# rails_ingress transport also forwards the live-connection facts the app
# can't otherwise see - the client IP ($sender_host_address) and HELO name
# ($sender_helo_name) - so the app can run SPF/DKIM/DMARC (rspamd) itself.
# Do not remove the stripping step.
######################################################################

#### Main configuration ##############################################

primary_hostname = @@EXIM_HELO_HOST@@

# Domains we host. Used to tell, for an authenticated submission, a local
# recipient (-> ingress) from a remote one (-> queue outbound), so mail to
# our own users isn't looped back out through our MX.
#
# File-based lookup so the Rails app can add/remove hosted domains at
# runtime: it rewrites this file (one domain per line) on the shared
# mailconf volume, and Exim re-reads it per connection - no restart needed.
# bin/entrypoint seeds it from EXIM_LOCAL_DOMAINS when absent (first boot).
# A MISSING file defers matches (4xx, senders retry); an EMPTY file means
# "no local domains" and 550s all inbound - the app refuses to write an
# empty list.
domainlist local_domains = lsearch;/var/lib/exim4/dynamic/local_domains

# Listeners. Kamal publishes host 25/587/465 -> these container ports 1:1
# (proxy: false in config/deploy.yml). 465 is implicit TLS.
daemon_smtp_ports = 25 : 587 : 465
tls_on_connect_ports = 465

# TLS material (Let's Encrypt, mounted read-only). When unset (dev), TLS
# is simply not advertised, which also means AUTH is not offered.
tls_certificate = @@EXIM_TLS_CERT@@
tls_privatekey  = @@EXIM_TLS_KEY@@
tls_advertise_hosts = ${if eq{@@EXIM_TLS_CERT@@}{}{}{*}}

# 24 MB, deliberately 1 MB under the app's 25 MB cap: clamd's stock
# StreamMaxLength is exactly 25 MB (26214400), and both this edge's
# DATA-time scan and the app's rescan stream the message WITH the
# Received/stamped headers Exim adds. At exactly 25 MB the scan would
# error and - fail-closed - defer forever; staying 1 MB under keeps a
# max-size message inside the stream cap on both paths.
message_size_limit = 25165824

# --- Abuse / DoS limits ------------------------------------------------
# Exim accepts every message and forwards each one to Rails (a Ruby spawn
# + HTTP POST per message), and every AUTH attempt spawns a check too, so
# bound the funnel. Tune to your real traffic.
# Concurrent inbound connections total / per source IP; messages per
# connection. (Exim has no inline comments, so these ride above the lines.)
smtp_accept_max                = 100
smtp_accept_max_per_host       = 10
smtp_accept_max_per_connection = 50
# RCPTs per message - each becomes one X-Original-To in the ingress POST.
recipients_max                 = 100
# Cap the header block; mail-loop protection.
header_maxsize                 = 1M
received_headers_max           = 30

# Don't advertise the Exim version in the banner.
smtp_banner = $smtp_active_hostname ESMTP

# TLS protocol floor. bin/entrypoint fills this in with the right directive
# for this build's TLS library (OpenSSL vs GnuTLS), or leaves it empty and
# relies on Exim's defaults if the library can't be detected.
@@EXIM_TLS_HARDENING@@

# Cleaned child environment: only these names reach the Ruby helpers.
# Exim empties the env for everything else by default.
keep_environment = INGRESS_URL : INGRESS_PASSWORD : INTERNAL_API_URL : INTERNAL_API_PASSWORD
add_environment  = <; PATH=/usr/local/bin:/usr/bin:/bin

# Exim requires %s in log_file_path and refuses to log to /dev/stdout, so it
# logs to files here. bin/entrypoint makes main/reject/paniclog FIFOs and
# streams each to the container's stdout, so `kamal logs` sees everything
# while nothing accumulates on disk (the pipes store nothing).
log_file_path = /var/log/exim4/%slog

acl_smtp_connect = acl_connect
acl_smtp_rcpt = acl_rcpt
acl_smtp_auth = acl_auth
acl_smtp_data = acl_data

# DATA-time virus scanning. bin/entrypoint renders this to
# `av_scanner = clamd:HOST PORT` when EXIM_CLAMAV_ADDR is set, or leaves
# it empty (no scanning - dev default). See acl_data below.
@@EXIM_AV_SCANNER@@


#### ACL #############################################################

begin acl

# Admin-managed permanent bans (the Rails app's BannedIp - auth attempts
# page plus the imported Spamhaus DROP list). One IP or CIDR per line on
# the shared mailconf volume; an absolute filename as a host-list item is
# re-read every time the list is checked, and the daemon forks per
# connection, so a ban takes effect for new connections with no restart -
# same contract as local_domains above. `drop` refuses the banner and
# closes, the cheapest answer to a sustained attacker.
#
# The Rails app rewrites the file on every ban/unban; bin/entrypoint seeds
# it EMPTY when absent because the two states differ: an EMPTY file means
# "no bans" (the normal steady state), while a MISSING file errors the
# host-list check and defers every connection with 4xx.
acl_connect:
  drop message = access denied
       hosts   = /var/lib/exim4/dynamic/banned_ips

  accept

acl_rcpt:
  # A connection established moments before its ban landed still gets cut
  # at the next RCPT (SMTP connections are short-lived; belt and braces).
  drop   message = access denied
         hosts   = /var/lib/exim4/dynamic/banned_ips

  # Per-IP recipient rate limit - dictionary/flood control. Authenticated
  # submitters are exempt (a person's client, not a flood source).
  defer  message        = rate limit exceeded, slow down
         !authenticated  = *
         ratelimit       = 100 / 1h / per_rcpt / strict / $sender_host_address

  # Authenticated submitters are exempt from recipient verification: they
  # send outbound (remote) and to local users; the routers sort that out.
  accept authenticated = *

  # Unauthenticated (inbound MX) from here down. Verify each recipient in a
  # domain we host so unknown users get a proper 550 (the sender's server
  # bounces) instead of being accepted and silently dropped.
  #
  # Like local_domains above, this is a file the Rails app rewrites on the
  # shared mailconf volume (one address per line, lowercased) on every
  # account add/remove/rename - a plain lsearch here instead of the HTTP
  # round trip to the app the edge used to make per RCPT. In an address
  # list a bare lookup is keyed by the complete address, matched caselessly,
  # so $local_part@$domain against the app's normalized lines just works.
  # A MISSING file fails the lookup and DEFERS the RCPT (4xx, senders
  # retry - same fail-safe as the old "app unreachable" path; the app seeds
  # the file at boot); an EMPTY file means "no accounts" and 550s below.
  accept domains    = +local_domains
         recipients = lsearch;/var/lib/exim4/dynamic/local_recipients

  deny   domains = +local_domains
         message = no such user here

  # Unauthenticated mail to a domain we don't host: relaying is not allowed
  # (this also never reaches the outbound router, which requires auth).
  deny   message = relaying not permitted

# Runs once the whole message has arrived (DATA). The deny block is
# substituted by bin/entrypoint: with EXIM_CLAMAV_ADDR set it is a
# `deny malware = *` (fail CLOSED - a scanner error or timeout defers
# with 451 and the sender retries; deliberately no defer_ok); unset it
# renders empty and everything falls through to accept. This also scans
# authenticated submissions, so outbound malware is stopped before it is
# DKIM-signed and relayed. The app rescans on ingress (defense in
# depth); no scan-verdict header is stamped here.
acl_data:
@@EXIM_MALWARE_DENY@@

  accept

# Throttle AUTH attempts per IP - each one spawns a Ruby check against the
# app, so this caps both brute force and its amplification.
acl_auth:
  defer  message   = too many authentication attempts, try later
         ratelimit = 10 / 1m / strict / $sender_host_address
  accept


#### Routers #########################################################

begin routers

# The ONLY path that leaves for another mail server: an authenticated
# submitter sending to a domain we don't host. Queue it in the app, which
# DKIM-signs and delivers to the recipient's MX. Unauthenticated senders
# never match this (no $authenticated_id), so Exim is not an open relay.
submission_outbound:
  driver    = accept
  condition = ${if def:authenticated_id}
  domains   = ! +local_domains
  transport = rails_outbound

# Everything else -> the app's relay ingress: all inbound mail (any
# recipient) and authenticated submission to local domains.
rails_ingress:
  driver    = accept
  transport = rails_ingress


#### Transports ######################################################

begin transports

# One pipe invocation per message (batch_max) carrying every recipient in
# $pipe_addresses, so the ingress is POSTed exactly once with an
# X-Original-To per recipient. Raw message on stdin, unaltered by Exim.
rails_ingress:
  driver         = pipe
  # Exim refuses to build a pipe command line out of tainted data - anything a
  # remote peer chose (envelope sender, client IP, HELO, AUTH id) - and fails
  # the delivery with "Tainted arg N for rails_ingress transport command".
  # ${base64:} does NOT untaint (taint propagates through it), and the only
  # untainting sources are lookups, which need a trusted table we cannot have
  # for arbitrary senders. So the connection facts travel in the environment
  # instead, which carries no such restriction, and only the recipients stay
  # on the command line - bare $pipe_addresses, which Exim expands into one
  # argument per recipient and exempts from the taint check (it is also the
  # only place that variable exists at all).
  #
  # They are base64 encoded because "environment" is a colon-separated list
  # and an IPv6 $sender_host_address is full of colons; it also stops any
  # value from injecting a second variable. rails-ingress decodes them.
  #
  # Setting "environment" REPLACES the inherited environment (keep_environment
  # above only governs what the Exim process itself keeps), so the two values
  # the helper needs are re-added here. ${env{}} reads them out of Exim's own
  # environment, so no secret is written into this file; ${sg{}{:}{::}} doubles
  # any colon, which the URL certainly has, so the list still parses.
  command        = /usr/local/bin/ruby /usr/local/bin/rails-ingress $pipe_addresses
  environment    = INGRESS_URL=${sg{${env{INGRESS_URL}}}{:}{::}} : INGRESS_PASSWORD=${sg{${env{INGRESS_PASSWORD}}}{:}{::}} : EXIM_SENDER=${base64:$sender_address} : EXIM_AUTH=${base64:$authenticated_id} : EXIM_IP=${base64:$sender_host_address} : EXIM_HELO=${base64:$sender_helo_name}
  batch_max      = 100
  use_shell      = false
  message_prefix =
  message_suffix =
  return_fail_output = true
  user           = Debian-exim
  group          = Debian-exim

rails_outbound:
  driver         = pipe
  # Environment-carried, base64-encoded, and with the INTERNAL_API_* values
  # re-added by reference - all for the same reasons as rails_ingress above.
  command        = /usr/local/bin/ruby /usr/local/bin/rails-outbound $pipe_addresses
  environment    = INTERNAL_API_URL=${sg{${env{INTERNAL_API_URL}}}{:}{::}} : INTERNAL_API_PASSWORD=${sg{${env{INTERNAL_API_PASSWORD}}}{:}{::}} : EXIM_SENDER=${base64:$sender_address} : EXIM_AUTH=${base64:$authenticated_id}
  batch_max      = 100
  use_shell      = false
  message_prefix =
  message_suffix =
  return_fail_output = true
  user           = Debian-exim
  group          = Debian-exim


#### Retry ###########################################################

begin retry

# Deferred (exit 75) handoffs: retry like a normal MTA before giving up.
*   *   F,2h,15m; G,16h,1h,1.5; F,4d,6h


#### Authenticators ##################################################

begin authenticators

# Credentials are verified against the app's internal API (bin/auth-check).
# Only offered once TLS is up and never on port 25 (MX). auth values are
# base64-wrapped through ${run} so passwords with spaces survive Exim's
# whitespace-split of the command line. The sender's address goes along as
# a third argument: the app throttles brute-force attempts per source IP
# and per account, so SMTP AUTH and IMAP LOGIN share one budget.

plain:
  driver                     = plaintext
  public_name                = PLAIN
  server_condition           = ${run{/usr/local/bin/ruby /usr/local/bin/auth-check ${base64:$auth2} ${base64:$auth3} ${base64:$sender_host_address}}{yes}{no}}
  server_set_id              = $auth2
  server_advertise_condition = ${if and{{def:tls_in_cipher}{!eq{$received_port}{25}}}{yes}{no}}

login:
  driver                     = plaintext
  public_name                = LOGIN
  server_prompts             = Username:: : Password::
  server_condition           = ${run{/usr/local/bin/ruby /usr/local/bin/auth-check ${base64:$auth1} ${base64:$auth2} ${base64:$sender_host_address}}{yes}{no}}
  server_set_id              = $auth1
  server_advertise_condition = ${if and{{def:tls_in_cipher}{!eq{$received_port}{25}}}{yes}{no}}
