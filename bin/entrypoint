#!/usr/bin/env ruby
# frozen_string_literal: true

# Render the Exim config from its @@PLACEHOLDER@@ template and start the
# daemon in the foreground as PID 1. Invoked as `ruby entrypoint` (see the
# Dockerfile ENTRYPOINT).
#
# TLS floor: the right directive differs by build (OpenSSL vs GnuTLS), so
# we render once, ask `exim4 -bV` which library this is, then re-render
# with the matching @@EXIM_TLS_HARDENING@@ (empty if undetected).

require "etc"
require "fileutils"

CONF = "/etc/exim4/exim4.conf"
TEMPLATE = "/etc/exim4/exim4.conf.template"
ALLOWED = %w[EXIM_HELO_HOST EXIM_TLS_CERT EXIM_TLS_KEY EXIM_TLS_HARDENING
             EXIM_AV_SCANNER EXIM_MALWARE_DENY].freeze
# Exim logs to files (it needs %s and won't write /dev/stdout); these three
# are turned into FIFOs streamed to our stdout below - matches %slog in the
# template's log_file_path.
LOG_DIR = "/var/log/exim4"
LOG_KINDS = %w[main reject panic].freeze
EXIM_UID = (Etc.getpwnam("Debian-exim").uid rescue nil)
EXIM_GID = (Etc.getgrnam("Debian-exim").gid rescue nil)

# All required. INGRESS_* is the inbound handoff; INTERNAL_API_* backs AUTH,
# outbound queueing, and - now - RCPT-time recipient verification, which
# every inbound message depends on, so the edge must not start without it.
# Fail fast here rather than let a misconfig surface as deferred live mail.
%w[EXIM_HELO_HOST INGRESS_URL INGRESS_PASSWORD INTERNAL_API_URL INTERNAL_API_PASSWORD].each do |key|
  abort "entrypoint: #{key} is not set" if ENV[key].to_s.strip.empty?
end

ENV["EXIM_LOCAL_DOMAINS"] = ENV["EXIM_HELO_HOST"] if ENV["EXIM_LOCAL_DOMAINS"].to_s.strip.empty?
ENV["EXIM_TLS_CERT"]     ||= ""
ENV["EXIM_TLS_KEY"]      ||= ""
ENV["EXIM_TLS_HARDENING"]  = "" # set below, after we detect the TLS library

# DATA-time virus scanning. EXIM_CLAMAV_ADDR (host:port, e.g.
# mail_on_rails-clamav:3310 - same convention as the app's
# SMTP_CLAMAV_ADDR) turns on clamd scanning; empty/unset renders both
# placeholders blank (dev default: no scanning). Fail CLOSED: no
# defer_ok, so a scanner error/timeout defers (451) instead of letting
# the message through. Scan timeout is Exim's default (tmo=2m).
clamav_addr = ENV["EXIM_CLAMAV_ADDR"].to_s.strip
if clamav_addr.empty?
  ENV["EXIM_AV_SCANNER"]   = ""
  ENV["EXIM_MALWARE_DENY"] = ""
else
  # The regex doubles as config-injection protection (no newlines, list
  # separators, or placeholder markers can reach the rendered config).
  # Underscores are allowed: docker container names have them (the prod
  # value is mail_on_rails-clamav) even though strict DNS hostnames don't.
  m = clamav_addr.match(/\A([A-Za-z0-9_][A-Za-z0-9._-]*):(\d{1,5})\z/) ||
      abort("entrypoint: EXIM_CLAMAV_ADDR must be host:port, got #{clamav_addr.inspect}")
  ENV["EXIM_AV_SCANNER"]   = "av_scanner = clamd:#{m[1]} #{m[2]}"
  ENV["EXIM_MALWARE_DENY"] = [
    "  deny    malware     = *",
    "          message     = message rejected: virus detected ($malware_name)",
    "          log_message = malware detected: $malware_name"
  ].join("\n")
end

# The config checks below open the logs, so the directory must exist first.
FileUtils.mkdir_p(LOG_DIR)
File.chown(EXIM_UID, EXIM_GID, LOG_DIR) if EXIM_UID

# Shared mailconf volume: the Rails app (uid 1000) owns local_domains and
# rewrites it on domain add/remove (Exim's lsearch re-reads it per
# connection). We only seed it from EXIM_LOCAL_DOMAINS when ABSENT - a
# redeploy must never clobber the Rails-managed list - and repair the dir
# perms so both sides can write regardless of which container mounted the
# fresh volume first.
DOMAINS_DIR  = "/var/lib/exim4/dynamic"
DOMAINS_FILE = File.join(DOMAINS_DIR, "local_domains")
FileUtils.mkdir_p(DOMAINS_DIR)
File.chmod(0o1777, DOMAINS_DIR)
unless File.exist?(DOMAINS_FILE)
  domains = ENV["EXIM_LOCAL_DOMAINS"].to_s.split(":").map(&:strip).reject(&:empty?)
  tmp = "#{DOMAINS_FILE}.seed.#{Process.pid}"
  File.write(tmp, domains.join("\n") + "\n")
  File.chmod(0o644, tmp)
  File.rename(tmp, DOMAINS_FILE)
end

# Rails-managed IP bans (acl_connect's host list). Seeded EMPTY when
# absent, and only then: empty means "no bans", missing would error the
# host-list check and defer every connection with 4xx - a fresh volume
# must not boot into that state while the app has yet to write the file.
BANNED_FILE = File.join(DOMAINS_DIR, "banned_ips")
unless File.exist?(BANNED_FILE)
  tmp = "#{BANNED_FILE}.seed.#{Process.pid}"
  File.write(tmp, "")
  File.chmod(0o644, tmp)
  File.rename(tmp, BANNED_FILE)
end

def render(template)
  rendered = template.gsub(/@@(\w+)@@/) do
    name = Regexp.last_match(1)
    abort "entrypoint: template references unknown @@#{name}@@" unless ALLOWED.include?(name)
    ENV[name].to_s
  end
  File.write(CONF, rendered)
  gid = begin
    Etc.getgrnam("Debian-exim").gid
  rescue ArgumentError
    nil
  end
  File.chown(0, gid, CONF) if gid
  File.chmod(0o640, CONF)
end

template = File.read(TEMPLATE)

# First render + validate. `exim4 -bV` also reports the TLS library it was
# built against, which we use to pick the protocol-floor directive.
render(template)
report = `/usr/sbin/exim4 -bV 2>&1`
# Checked before the generic abort: daemon-light chokes on av_scanner
# itself, and this message says why.
if !clamav_addr.empty? && !report.include?("Content_Scanning")
  abort "entrypoint: EXIM_CLAMAV_ADDR is set but this Exim build lacks " \
        "Content_Scanning - the image must install exim4-daemon-heavy (see Dockerfile)"
end
abort "entrypoint: exim config check failed:\n#{report}" unless $?.success?

ENV["EXIM_TLS_HARDENING"] =
  if report.include?("OpenSSL")
    "openssl_options = +no_sslv2 +no_sslv3 +no_tlsv1 +no_tlsv1_1"
  elsif report.match?(/GnuTLS/i)
    "tls_require_ciphers = NORMAL:-VERS-ALL:+VERS-TLS1.2:+VERS-TLS1.3"
  else
    "" # unknown library - leave Exim's defaults in place
  end

unless ENV["EXIM_TLS_HARDENING"].empty?
  render(template)
  abort "entrypoint: config check failed after TLS hardening" \
    unless system("/usr/sbin/exim4", "-bV", out: File::NULL, err: File::NULL)
end

# Turn the three log files into FIFOs so nothing accumulates on disk, and
# stream the main log to our own stdout for `kamal logs`. Exim copies reject
# and panic entries into the main log too, so we only DRAIN those two pipes
# (to /dev/null) - forwarding them as well would double every such line -
# while still keeping Exim from blocking on a full pipe. The `while` loop
# re-opens a pipe if Exim closes it (log reopen); these spawn()ed forwarders
# keep running across the exec below.
LOG_KINDS.each do |kind|
  path = File.join(LOG_DIR, "#{kind}log")
  File.unlink(path) if File.exist?(path)
  File.mkfifo(path, 0o660)
  File.chown(EXIM_UID, EXIM_GID, path) if EXIM_UID
  sink = kind == "main" ? "" : "> /dev/null"
  spawn("/bin/sh", "-c", "while :; do cat #{path} #{sink}; done")
end

# -bd daemon, -q30m runs the retry queue every 30 min. -v keeps Exim in the
# foreground (PID 1) - it also copies the main log to stderr, so we discard
# stderr and let the main-log FIFO be the single log source. Panics still
# surface there too (Exim copies panic entries into the main log).
exec("/usr/sbin/exim4", "-bd", "-q30m", "-v", err: "/dev/null")
