#!/usr/bin/env ruby
# frozen_string_literal: true

# Liveness: the MX listener must answer its 220 banner.

require "socket"
require "timeout"

begin
  Timeout.timeout(5) do
    socket = TCPSocket.new("127.0.0.1", 25)
    line = socket.gets
    socket.close
    exit(line.to_s.start_with?("2") ? 0 : 1)
  end
rescue StandardError
  exit 1
end
