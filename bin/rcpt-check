#!/usr/bin/env ruby
# frozen_string_literal: true

# RCPT TO recipient verification, called once per recipient from acl_rcpt
# for mail to a domain we host:
#
#   rcpt-check <base64 local_part@domain>
#
# The address is base64-wrapped because Exim splits the ${run} command on
# whitespace. It is checked against the app's internal API (the same
# rcpt_check the store contract exposes), which echoes back the subset of
# the submitted addresses that map to a real local account.
#
# Exit codes drive the ACL:
#   0  accept  - a real local account -> continue in acl_rcpt;
#   1  deny    - a domain we host but no such account -> 550 in acl_rcpt;
#   2  defer   - can't verify right now (API not configured / unreachable /
#               non-2xx) -> 451. We never accept without a positive answer:
#               an unverifiable recipient is tempfailed so the sender
#               retries, never silently accepted. (bin/entrypoint hard-
#               requires INTERNAL_API_URL, so "not configured" shouldn't
#               happen in a running edge - this is just the safe default.)
#
# The pure bits (decode, local?) are covered by test/rcpt_check_test.rb;
# #main runs only when executed directly.

require "net/http"
require "uri"
require "json"

module RcptCheck
  # Decode the base64 command-line argument back to the plaintext address.
  def self.decode(arg)
    arg.to_s.unpack1("m").to_s
  end

  # The endpoint (POST, HTTP basic auth), trailing slash on the base trimmed
  # so we never build a "//rcpt_check".
  def self.endpoint(base)
    URI("#{base.to_s.sub(%r{/\z}, '')}/rcpt_check")
  end

  # The response lists (normalized: stripped + lowercased) the addresses that
  # are local accounts. Local iff ours is in it. Pure.
  def self.local?(body, address)
    locals = JSON.parse(body.to_s)["local"]
    locals.is_a?(Array) &&
      locals.map { |a| a.to_s.strip.downcase }.include?(address.strip.downcase)
  rescue JSON::ParserError
    false
  end

  def self.post(base, api_password, address)
    uri = endpoint(base)
    request = Net::HTTP::Post.new(uri)
    request.basic_auth("mail_on_rails", api_password)
    request.set_form_data("addresses[]" => address)
    Net::HTTP.start(uri.hostname, uri.port, use_ssl: uri.scheme == "https",
                    open_timeout: 5, read_timeout: 10, write_timeout: 10,
                    min_version: :TLS1_2) { |http| http.request(request) }
  end

  # Returns the process exit code (0 accept, 1 deny, 2 defer).
  def self.main(argv)
    base = ENV["INTERNAL_API_URL"].to_s
    api_password = ENV["INTERNAL_API_PASSWORD"].to_s
    # No internal API configured -> can't verify -> defer, never accept.
    # (bin/entrypoint hard-requires it, so this is a belt-and-suspenders path.)
    return 2 if base.empty? || api_password.empty?

    address = decode(argv[0])
    return 2 if address.empty?

    begin
      response = post(base, api_password, address)
    rescue StandardError
      return 2
    end
    return 2 unless (200..299).cover?(response.code.to_i)

    local?(response.body, address) ? 0 : 1
  end
end

exit RcptCheck.main(ARGV) if $PROGRAM_NAME == __FILE__
